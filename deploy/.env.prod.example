# =============================================================================
# Production Environment Configuration
# Copy to .env.prod and fill in all values before deployment.
# =============================================================================

# --- Docker Image ---
WEB_IMAGE=ghcr.io/your-org/cinemamanagement:latest

# --- SQL Server ---
MSSQL_SA_PASSWORD=CHANGE_ME_STRONG_PASSWORD
MSSQL_PID=Express

# --- App Connection String ---
ConnectionStrings__DefaultConnection=Server=cinema-db,1433;Database=QuanLyRapPhim;User Id=sa;Password=CHANGE_ME_STRONG_PASSWORD;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=True

# --- Redis ---
ConnectionStrings__Redis=cinema-redis:6379

# --- RabbitMQ ---
RABBITMQ_USER=cinema
RABBITMQ_PASSWORD=CHANGE_ME_RABBITMQ_PASSWORD
ConnectionStrings__RabbitMQ=amqp://cinema:CHANGE_ME_RABBITMQ_PASSWORD@cinema-rabbitmq:5672/

# --- MongoDB (optional, if review/catalog document storage is enabled) ---
# Production compose does not start MongoDB by default. Point these values to
# a managed/external MongoDB instance, or add a MongoDB service to compose.
# ConnectionStrings__MongoDB=mongodb://mongo-host:27017
# MongoDB__DatabaseName=CinemaReviews

# --- MinIO (S3-compatible Object Storage) ---
MinIO__Endpoint=cinema-minio:9000
MinIO__AccessKey=minioadmin
MinIO__SecretKey=CHANGE_ME_MINIO_SECRET
MinIO__UseSSL=false
MinIO__BucketName=cinema-posters
# Public URL for poster images (proxied through Nginx)
MinIO__PublicBaseUrl=/posters

# --- Google OAuth ---
Authentication__Google__ClientId=YOUR_GOOGLE_CLIENT_ID
Authentication__Google__ClientSecret=YOUR_GOOGLE_CLIENT_SECRET

# --- VNPay ---
VnPay__TmnCode=YOUR_VNPAY_TMN_CODE
VnPay__HashSecret=YOUR_VNPAY_HASH_SECRET
VnPay__BaseUrl=https://pay.vnpay.vn/vpcpay.html
VnPay__ReturnUrl=https://cinema.yourdomain.com/HoaDon/VnPayReturn

# --- Domain & SSL ---
DOMAIN_NAME=cinema.yourdomain.com
CERTBOT_EMAIL=admin@yourdomain.com

# --- Backup ---
BACKUP_RETENTION_DAYS=7

# --- MinIO Credentials (for docker-compose) ---
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
GRAFANA_ROOT_URL=https://cinema.yourdomain.com/grafana
