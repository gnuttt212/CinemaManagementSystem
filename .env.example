# Copy this file to .env for local Docker Compose runs.

ASPNETCORE_ENVIRONMENT=Development

WEB_HOST_PORT=8080
MSSQL_HOST_PORT=14333
MSSQL_SA_PASSWORD=CinemaDev@12345

# Optional for Google OAuth local testing.
# Register this redirect URI in Google Console:
# http://localhost:8080/signin-google
GOOGLE_CLIENT_ID=PLACEHOLDER_CLIENT_ID
GOOGLE_CLIENT_SECRET=PLACEHOLDER_CLIENT_SECRET

# Optional for VNPay sandbox local testing.
VNPAY_TMN_CODE=PLACEHOLDER_TMN_CODE
VNPAY_HASH_SECRET=PLACEHOLDER_HASH_SECRET
VNPAY_BASE_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:8080/HoaDon/VnPayReturn

# =============================================================================
# Production — see deploy/.env.prod.example for full production config.
# =============================================================================
# DOMAIN_NAME=cinema.yourdomain.com
# CERTBOT_EMAIL=admin@yourdomain.com
# MSSQL_PID=Express
# BACKUP_RETENTION_DAYS=7
